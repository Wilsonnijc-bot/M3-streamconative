202, "54": 0.16556475141728838, "68": 0.16103459124053388, "50": 0.15687151729875587}, "graph_node_selection_ms": 3.532564005581662, "reranking_ms": 0.0, "returned_node_ids": [6, 56, 59, 70, 84, 107, 118, 125, 135, 145, 165, 185, 234, 279, 333, 367, 451, 479, 719, 723], "returned_node_scores": {"56": 0.5593091496601623, "118": 0.48081734890218564, "367": 0.42246425647456604, "84": 0.41583296090472766, "135": 0.4136512778751004, "125": 0.40749752804312855, "165": 0.3909023949286896, "145": 0.3885382760156018, "451": 0.3823473738498447, "107": 0.3618155315076799, "723": 0.34251286099598793, "279": 0.32601714481820515, "719": 0.3138829876772896, "70": 0.30233868642353645, "6": 0.2862465724016522, "59": 0.28396366505361637, "185": 0.26398151696996175, "234": 0.252957415637257, "479": 0.2220448748199304, "333": 0.2205591637935423}, "retrieval_round_total_ms": 365.1302869984647, "embedding": {"call_count": 1, "each_call_ms": [277.1493799955351], "total_ms": 277.1493799955351, "model": "openai/text-embedding-3-large", "provider": "OpenRouter", "calls": [{"index": 0, "latency_ms": 277.1493799955351, "input_chars": 32, "tokens": 9, "dimension": 3072, "provider": "OpenRouter", "model": "openai/text-embedding-3-large"}]}, "retrieval": {"dense_ms": 82.35579800384585, "sparse_ms": 0.0, "StreamMeCo/TMR_ms": 0.628000998403877, "Mandol_search_ms": 0.0, "graph_traversal_ms": 3.532564005581662, "rerank_ms": 0.0, "other_ms": 0.011612995876930654, "TOTAL_RETRIEVAL_MS": 365.1302869984647}, "evidence": [{"rank": 1, "node_id": 6, "node_type": "episodic", "timestamp": 1, "score": 0.2862465724016522, "contents": ["She turns around, adjusts her hair, and picks up her backpack and phone from the bed."]}, {"rank": 2, "node_id": 56, "node_type": "semantic", "timestamp": 6, "score": 0.5593091496601623, "contents": ["The woman is frustrated by the cluttered condition of the desk and suspects someone named Emma caused it."]}, {"rank": 3, "node_id": 59, "node_type": "episodic", "timestamp": 7, "score": 0.28396366505361637, "contents": ["A young woman in a white jacket sits at a table cluttered with papers, stationery, and drinks."]}, {"rank": 4, "node_id": 70, "node_type": "episodic", "timestamp": 8, "score": 0.30233868642353645, "contents": ["The camera moves back to show a woman seated at the table arranging items inside her bag."]}, {"rank": 5, "node_id": 84, "node_type": "semantic", "timestamp": 9, "score": 0.41583296090472766, "contents": ["The woman is examining an academic curriculum or class schedule belonging to Emma."]}, {"rank": 6, "node_id": 107, "node_type": "semantic", "timestamp": 11, "score": 0.3618155315076799, "contents": ["The person in the yellow jacket (<voice_96>) enters the apartment and greets the woman sitting at the dining table, identifying her as Emma."]}, {"rank": 7, "node_id": 118, "node_type": "semantic", "timestamp": 12, "score": 0.48081734890218564, "contents": ["Emma complies with the woman's request to throw something into the bin before heading into the bedroom to rest."]}, {"rank": 8, "node_id": 125, "node_type": "semantic", "timestamp": 13, "score": 0.40749752804312855, "contents": ["The woman on the bed is addressed as Emma."]}, {"rank": 9, "node_id": 135, "node_type": "semantic", "timestamp": 14, "score": 0.4136512778751004, "contents": ["The woman in the beige top is Emma, who appears upset or troubled."]}, {"rank": 10, "node_id": 145, "node_type": "semantic", "timestamp": 15, "score": 0.3885382760156018, "contents": ["The camera wearer is tidying up the bedroom by picking up clothing from the bed."]}, {"rank": 11, "node_id": 165, "node_type": "semantic", "timestamp": 17, "score": 0.3909023949286896, "contents": ["<voice_21> demonstrates deep empathy, patience, and emotional support to help soothe Emma."]}, {"rank": 12, "node_id": 185, "node_type": "episodic", "timestamp": 19, "score": 0.26398151696996175, "contents": ["The woman in the cream sweater (<voice_180>) remarks on her carelessness as the discussion concludes."]}, {"rank": 13, "node_id": 234, "node_type": "episodic", "timestamp": 24, "score": 0.252957415637257, "contents": ["<voice_179> looks downward, explaining that her mother always stresses heavily over her academic performance."]}, {"rank": 14, "node_id": 279, "node_type": "semantic", "timestamp": 28, "score": 0.32601714481820515, "contents": ["The person wearing black gloves is clearing and organizing the table from a first-person perspective."]}, {"rank": 15, "node_id": 333, "node_type": "episodic", "timestamp": 34, "score": 0.2205591637935423, "contents": ["The woman on the right rests her chin on her hands and asks the woman on the left how she manages to remain passionate and energetic about her work when it seems so exhausting."]}, {"rank": 16, "node_id": 367, "node_type": "semantic", "timestamp": 37, "score": 0.42246425647456604, "contents": ["<voice_358> expresses admiration and affirmation toward Emma."]}, {"rank": 17, "node_id": 451, "node_type": "semantic", "timestamp": 46, "score": 0.3823473738498447, "contents": ["The woman seated on the left is Emma."]}, {"rank": 18, "node_id": 479, "node_type": "semantic", "timestamp": 49, "score": 0.2220448748199304, "contents": ["The two women are close friends or housemates having an intimate conversation in a casual home setting."]}, {"rank": 19, "node_id": 719, "node_type": "semantic", "timestamp": 75, "score": 0.3138829876772896, "contents": ["The robot successfully navigates into the bedroom, identifies a used tea cup on the side table, and retrieves it to clean up the room as commanded."]}, {"rank": 20, "node_id": 723, "node_type": "semantic", "timestamp": 76, "score": 0.34251286099598793, "contents": ["The person is performing cleaning or housekeeping duties in a living space or hotel room."]}], "query_construction_ms": 0.000890999217517674, "query_generation_ms": 0.0}], "controller": {"call_count": 0, "each_call_ms": [], "total_ms": 0.0}, "controller_calls": [], "final_answer_call": {"phase": "eval", "quest